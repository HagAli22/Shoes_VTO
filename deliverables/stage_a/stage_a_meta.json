    "stage_a_320_int8": "443dd13964a3dc464d9eb501adcbdaaedb128da36da9464978438e26955b8153",
    "stage_a_256_fp32": "c46a519138b3fa9d213453a83e6db0956ac2a6e81bfe6ce9f7d380b0b6d46280"
  }
